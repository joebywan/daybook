{"repo": {"name": {"en-US": "Daybook"}, "description": {"en-US": "Daybook, the daily logic-puzzle app, straight from its releases."}, "icon": {"en-US": {"name": "/icons/icon.png", "sha256": "8647ae45970b2b0b87f638bd5840cf6ed68abdf50e551d4b29c655056770f68a", "size": 15499}}, "address": "https://knowhowit.com.au/daybook/fdroid/repo", "timestamp": 1791039523000, "categories": {"Games": {"name": {"en-US": "Games"}}}}, "packages": {"com.joebywan.daybook": {"metadata": {"added": 1791031125000, "categories": ["Games"], "changelog": "https://github.com/joebywan/daybook/releases", "issueTracker": "https://github.com/joebywan/daybook/issues", "lastUpdated": 1791039522000, "license": "AGPL-3.0-or-later", "sourceCode": "https://github.com/joebywan/daybook", "webSite": "https://knowhowit.com.au/daybook/", "featureGraphic": {"en-US": {"name": "/com.joebywan.daybook/en-US/featureGraphic_Hm1zzdMvpnajMd6jqxJ-14ba_yx54aj3pm11F0VURPE=.png", "sha256": "1e6d73cdd32fa676a331dea3ab127ed786daff2c79e1a8f7a66d7517455444f1", "size": 90666}, "en-AU": {"name": "/com.joebywan.daybook/en-AU/featureGraphic_Hm1zzdMvpnajMd6jqxJ-14ba_yx54aj3pm11F0VURPE=.png", "sha256": "1e6d73cdd32fa676a331dea3ab127ed786daff2c79e1a8f7a66d7517455444f1", "size": 90666}}, "screenshots": {"phone": {"en-AU": [{"name": "/com.joebywan.daybook/en-AU/phoneScreenshots/1-home.png", "sha256": "438ca5b2382b7beeb29790ba8c0711d46534bb42f4c5b59e2b12736cd8aa321b", "size": 163886}, {"name": "/com.joebywan.daybook/en-AU/phoneScreenshots/2-sudoku-hint.png", "sha256": "99e0154ff4e30617a28f58f44491037f232cfb627866d1be235c6d69722fcddf", "size": 142198}, {"name": "/com.joebywan.daybook/en-AU/phoneScreenshots/3-kings.png", "sha256": "899f797135ef3fc30d2c06778cd6a9a726fb24002db7ce29be59991d33900a08", "size": 71583}, {"name": "/com.joebywan.daybook/en-AU/phoneScreenshots/4-mosaic.png", "sha256": "46c9c1aa88f766309073bc44fd8918faaa29e59a845cdb7a95bbffce46c68272", "size": 78021}, {"name": "/com.joebywan.daybook/en-AU/phoneScreenshots/5-snap.png", "sha256": "e441b2aade40011773388ad941ac12cf589f1ee2a69ca8a793a66fefe00e2bf7", "size": 100797}], "en-US": [{"name": "/com.joebywan.daybook/en-US/phoneScreenshots/1-home.png", "sha256": "438ca5b2382b7beeb29790ba8c0711d46534bb42f4c5b59e2b12736cd8aa321b", "size": 163886}, {"name": "/com.joebywan.daybook/en-US/phoneScreenshots/2-sudoku-hint.png", "sha256": "99e0154ff4e30617a28f58f44491037f232cfb627866d1be235c6d69722fcddf", "size": 142198}, {"name": "/com.joebywan.daybook/en-US/phoneScreenshots/3-kings.png", "sha256": "899f797135ef3fc30d2c06778cd6a9a726fb24002db7ce29be59991d33900a08", "size": 71583}, {"name": "/com.joebywan.daybook/en-US/phoneScreenshots/4-mosaic.png", "sha256": "46c9c1aa88f766309073bc44fd8918faaa29e59a845cdb7a95bbffce46c68272", "size": 78021}, {"name": "/com.joebywan.daybook/en-US/phoneScreenshots/5-snap.png", "sha256": "e441b2aade40011773388ad941ac12cf589f1ee2a69ca8a793a66fefe00e2bf7", "size": 100797}]}}, "authorName": "Joseph Howe", "name": {"en-US": "Daybook: Daily Logic Puzzles"}, "summary": {"en-US": "New logic puzzles every day. No ads, no subscription, works offline."}, "description": {"en-US": "Daybook is a daily logic-puzzle app for people who like to think.\n\nEvery day brings a fresh set of classic logic puzzles: Sudoku, region and placement puzzles, number, sign and symbol grids, pipe networks, flood-fills, one-line paths and code-breaking. Each comes in three difficulties, Standard, Hard and Expert, and each is built so that it has exactly one answer you can reach by reasoning. Nothing needs guessing.\n\nNO ADS. NO SUBSCRIPTION. NO ACCOUNT.\nThere are no adverts, no paywall, no sign-in and no in-app purchases. The app does not even ask for network access, so it works on a plane, on a train and in a tunnel.\n\nTHE WHOLE ARCHIVE, FROM DAY ONE\nPuzzles are made on your device from the date, so every past day is already there. Missed a week? Play it. Want something different? Switch to Random boards at any difficulty.\n\nLEARN AS YOU GO\nStuck? Ask for a hint and Daybook explains the next step in plain language, pointing at the cells it is talking about, rather than just filling one in. Every puzzle has a short walkthrough for first-timers, and \"How to play\" is always one tap away.\n\nKEEP YOUR STREAK\nTrack your daily streak, your times and your statistics, all stored privately on your phone.\n\nPRIVATE BY DESIGN\nDaybook collects nothing. No analytics, no trackers, no third-party SDKs. Your progress never leaves your device.\n\nHand-built puzzle generators, proven boards and a calm, uncluttered design. Come back tomorrow for the next one.\n"}, "icon": {"en-US": {"name": "/com.joebywan.daybook/en-US/icon_Q2fi4PMAk_VMxvoT9L1kh_2k11SKYFy16CTODIGi54s=.png", "sha256": "4367e2e0f30093f54cc6fa13f4bd6487fda4d7548a605cb5e824ce0c81a2e78b", "size": 17916}, "en-AU": {"name": "/com.joebywan.daybook/en-AU/icon_Q2fi4PMAk_VMxvoT9L1kh_2k11SKYFy16CTODIGi54s=.png", "sha256": "4367e2e0f30093f54cc6fa13f4bd6487fda4d7548a605cb5e824ce0c81a2e78b", "size": 17916}}, "preferredSigner": "70248a01bfc43a99422ce6be6c470146531ead24e96acd288d5df81ac18176f4"}, "versions": {"2f59960d5d37d1b8cb41c76be750fa3a397b2d75b3455fd9a4bc50b3eedc7fe0": {"added": 1791039522000, "file": {"name": "/daybook-0.1.116.apk", "sha256": "2f59960d5d37d1b8cb41c76be750fa3a397b2d75b3455fd9a4bc50b3eedc7fe0", "size": 13347103}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.1.116", "versionCode": 116, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 36}, "signer": {"sha256": ["70248a01bfc43a99422ce6be6c470146531ead24e96acd288d5df81ac18176f4"]}, "usesPermission": [{"name": "com.joebywan.daybook.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "c5d71976214c79352bc6feebe1e584b2b4e0587042a7ecf0746adba0fc7e1daa": {"added": 1791036839000, "file": {"name": "/daybook-0.1.115.apk", "sha256": "c5d71976214c79352bc6feebe1e584b2b4e0587042a7ecf0746adba0fc7e1daa", "size": 13347095}, "manifest": {"nativecode": ["arm64-v8a", "armeabi