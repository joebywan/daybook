, "sha256": "e441b2aade40011773388ad941ac12cf589f1ee2a69ca8a793a66fefe00e2bf7", "size": 100797}], "en-US": [{"name": "/com.joebywan.daybook/en-US/phoneScreenshots/1-home.png", "sha256": "2c82350480bec912be52bd194f88a7244f6de27beb737a643647527177fa5edf", "size": 179392}, {"name": "/com.joebywan.daybook/en-US/phoneScreenshots/2-sudoku-hint.png", "sha256": "237b11d301457255b9eddd23e01e02ead79d821d37326ad1d386d632bfa88dda", "size": 133579}, {"name": "/com.joebywan.daybook/en-US/phoneScreenshots/3-cage-sudoku-hint.png", "sha256": "321e5ea57c5109caed6a374d41a8661060b112887e372849cfcc7157b4899b88", "size": 162173}, {"name": "/com.joebywan.daybook/en-US/phoneScreenshots/3-kings.png", "sha256": "9827bd9d426331a4c3e9f299ec1afcc1cfb3876dbfbbf76f54fe9280a295bcf3", "size": 73736}, {"name": "/com.joebywan.daybook/en-US/phoneScreenshots/4-mosaic.png", "sha256": "b7b60fde912fe66420e233f26a738e919ddeb7aeeebcc061b209ad8dc60fa622", "size": 89083}, {"name": "/com.joebywan.daybook/en-US/phoneScreenshots/4-word-wheel.png", "sha256": "f3906d34fc12a65e8b3d4a9cb8289f71366b77b0030e72c3bebd35a867adab2b", "size": 114377}, {"name": "/com.joebywan.daybook/en-US/phoneScreenshots/5-kings.png", "sha256": "da3424df6de1e1396f0afbfe93783e617950275e42be4f25af2f6ede5c7ac06f", "size": 73250}, {"name": "/com.joebywan.daybook/en-US/phoneScreenshots/5-snap.png", "sha256": "ac75a9182f300c9faf65e8b9d392d8ec7bdeef7a07f4958d33d563088e2436e9", "size": 106721}, {"name": "/com.joebywan.daybook/en-US/phoneScreenshots/6-mosaic.png", "sha256": "1278758ece36f2fe1b906b0f6210792a4ef819cfaf0f9747e05f00ddb4beb250", "size": 87920}, {"name": "/com.joebywan.daybook/en-US/phoneScreenshots/7-snap.png", "sha256": "3f1c7090ae85c477d1ce0ad25fee80d2f50290307eb64bc6c3b463b33af88b50", "size": 101752}]}, "sevenInch": {"en-US": [{"name": "/com.joebywan.daybook/en-US/sevenInchScreenshots/1-home.png", "sha256": "18a61661e6f90f41097eec932f0c3249ef67863990b742a0ce22b6d366c19028", "size": 254402}, {"name": "/com.joebywan.daybook/en-US/sevenInchScreenshots/2-sudoku-hint.png", "sha256": "53be71bb3ea9b1856cf69cae2eb6c7b33ec6896ca2daf1c0230ea62a70b9571f", "size": 130730}, {"name": "/com.joebywan.daybook/en-US/sevenInchScreenshots/3-cage-sudoku-hint.png", "sha256": "491b3349efdd4f8992887c9c45b671e78ca920e3cd82fe2e1040385220b02ae7", "size": 166088}, {"name": "/com.joebywan.daybook/en-US/sevenInchScreenshots/4-word-wheel.png", "sha256": "ee0fc415f042c5a5d9139d8f04eb836e6228167c1e765f51ca938df4c0068aa8", "size": 156755}, {"name": "/com.joebywan.daybook/en-US/sevenInchScreenshots/5-kings.png", "sha256": "1ec1a77b2aa70902a90d2bfba2978fb6410f86013652ef2488a7472bab6e33c3", "size": 113161}, {"name": "/com.joebywan.daybook/en-US/sevenInchScreenshots/6-mosaic.png", "sha256": "08ba5a18d390aca3cdc790704ef637e47bdc9c8b2235e6c5e63628856b11c36c", "size": 137025}, {"name": "/com.joebywan.daybook/en-US/sevenInchScreenshots/7-snap.png", "sha256": "4cd2b301de32e6941d0e4e5cbd7d3d9d204b2b444257513188afe39722ec4885", "size": 158312}]}, "tenInch": {"en-US": [{"name": "/com.joebywan.daybook/en-US/tenInchScreenshots/1-home.png", "sha256": "18a61661e6f90f41097eec932f0c3249ef67863990b742a0ce22b6d366c19028", "size": 254402}, {"name": "/com.joebywan.daybook/en-US/tenInchScreenshots/2-sudoku-hint.png", "sha256": "53be71bb3ea9b1856cf69cae2eb6c7b33ec6896ca2daf1c0230ea62a70b9571f", "size": 130730}, {"name": "/com.joebywan.daybook/en-US/tenInchScreenshots/3-cage-sudoku-hint.png", "sha256": "491b3349efdd4f8992887c9c45b671e78ca920e3cd82fe2e1040385220b02ae7", "size": 166088}, {"name": "/com.joebywan.daybook/en-US/tenInchScreenshots/4-word-wheel.png", "sha256": "ee0fc415f042c5a5d9139d8f04eb836e6228167c1e765f51ca938df4c0068aa8", "size": 156755}, {"name": "/com.joebywan.daybook/en-US/tenInchScreenshots/5-kings.png", "sha256": "1ec1a77b2aa70902a90d2bfba2978fb6410f86013652ef2488a7472bab6e33c3", "size": 113161}, {"name": "/com.joebywan.daybook/en-US/tenInchScreenshots/6-mosaic.png", "sha256": "08ba5a18d390aca3cdc790704ef637e47bdc9c8b2235e6c5e63628856b11c36c", "size": 137025}, {"name": "/com.joebywan.daybook/en-US/tenInchScreenshots/7-snap.png", "sha256": "4cd2b301de32e6941d0e4e5cbd7d3d9d204b2b444257513188afe39722ec4885", "size": 158312}]}}, "authorName": "Joseph Howe", "name": {"en-US": "Daybook Puzzles: Daily Sudoku"}, "summary": {"en-US": "Daily sudoku, nonograms, word and logic puzzles. No ads, no account, offline."}, "description": {"en-US": "Daily Sudoku, killer sudoku, nonograms, word games and logic puzzles, free and with no ads. No account, no internet needed, and every past day is open from the start.\n\nEvery day brings a fresh set of classic pencil puzzles and brain games, each in three difficulties (Standard, Hard and Expert), each built so it has exactly one answer you can reach by reasoning. Nothing needs guessing.\n\nWHAT'S INSIDE\n• Sudoku, and Cage Sudoku (killer sudoku, with sum cages)\n• Nonogram picture grids\n• Futoshiki-style inequality grids, Shikaku rectangles, LITS, Tents and trees\n• Star Battle-style crown placement, Takuzu-style binary grids, Hashi-style bridges\n• Number puzzles: sums, letter sums (cryptarithms) and hit-the-target arithmetic\n• Dominoes: lay every tile so each coloured region keeps its rule\n• Word puzzles: a hidden-word guessing game and a word wheel\n• Chess puzzles: mate in 2, 3 and 4\n• Relaxing ones too: pipe rotation, flood-fill, one-line paths, colour sorting and arrows to clear\n\nHINTS THAT TEACH\nStuck? Ask for a hint and Daybook explains the next step in plain language, pointing at the squares it is talking about. You make the move yourself, so you learn the technique instead of watching it get filled in. Every puzzle has a short walkthrough for first-timers, and \"How to play\" is always one tap away.\n\nNO ADS. NO SUBSCRIPTION. NO ACCOUNT.\nThere are no adverts, no paywall, no sign-in and no in-app purchases. The app does not even ask for network access, so these are true offline puzzles: they work on a plane, on a train and in a tunnel.\n\nTHE WHOLE ARCHIVE, FROM DAY ONE\nPuzzles are made on your device from the date, so every past day is already there. Missed a week? Play it. Want more? Switch to Random boards at any difficulty.\n\nKEEP YOUR STREAK\nTrack your daily streak, your times and your statistics, all stored privately on your phone.\n\nPRIVATE BY DESIGN\nDaybook collects nothing. No analytics, no trackers, no third-party SDKs. Your progress never leaves your device.\n\nPHONES AND TABLETS\nTurn your phone on its side or play on a tablet and the board sits beside the controls.\n\nPLAY ANYWHERE\nThe same daily puzzles run in a web browser at knowhowit.com.au/daybook, no install needed.\n\nOpen source, with hand-built puzzle generators, proven boards and a calm, uncluttered design. Come back tomorrow for the next one.\n"}, "icon": {"en-US": {"name": "/com.joebywan.daybook/en-US/icon_Q2fi4PMAk_VMxvoT9L1kh_2k11SKYFy16CTODIGi54s=.png", "sha256": "4367e2e0f30093f54cc6fa13f4bd6487fda4d7548a605cb5e824ce0c81a2e78b", "size": 17916}, "en-AU": {"name": "/com.joebywan.daybook/en-AU/icon_Q2fi4PMAk_VMxvoT9L1kh_2k11SKYFy16CTODIGi54s=.png", "sha256": "4367e2e0f30093f54cc6fa13f4bd6487fda4d7548a605cb5e824ce0c81a2e78b", "size": 17916}}, "preferredSigner": "70248a01bfc43a99422ce6be6c470146531ead24e96acd288d5df81ac18176f4"}, "versions": {"4d2610987c488c89db8692be5120009c14cdc43099ac129751a73e3a44daf9d6": {"added": 1792845344000, "file": {"name": "/daybook-1.1.201.apk", "sha256": "4d2610987c488c89db8692be5120009c14cdc43099ac129751a73e3a44daf9d6", "size": 2548515}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.1.201", "versionCode": 201, "usesSdk": {"minSdkVersion": 25, "targetSdkVersion": 36}, "signer": {"sha256": ["70248a01bfc43a99422ce6be6c470146531ead24e96acd288d5df81ac18176f4"]}, "usesPermission": [{"name": "com.joebywan.daybook.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "5180a797adc7ed4f9b1891ff9bd99ae92e5be0bd8f0db3b160811645bac89b61": {"added": 1792843753000, "file": {"